+                             const struct sockaddr* addr,
+                             unsigned int addrlen,
+                             uv_udp_send_cb send_cb) {
+  int checked_addrlen;
+
+  checked_addrlen = uv__udp_check_explicit_addrlen(handle, addr, addrlen);
+  if (checked_addrlen < 0)
+    return checked_addrlen;
+
+  return uv__udp_send(req,
+                      handle,
+                      bufs,
+                      nbufs,
+                      addr,
+                      checked_addrlen,
+                      send_cb);
+}
